<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Go2Ways — Enterprise Asset Management & Cloud Modernization</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    :root {
      --ms-blue: #0067B8;
      --ms-blue-hover: #005DA6;
      --ms-bg-warm: #FAF9F8;
      --ms-surface: #FFFFFF;
      --ms-gray-light: #F2F2F2;
      --ms-text-dark: #1B1A19;
      --ms-text-muted: #605E5C;
      --fluent-silk: cubic-bezier(0.22, 1, 0.36, 1);
    }

    body {
      font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
      color: var(--ms-text-dark);
      background-color: var(--ms-bg-warm);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* Microsoft Mica / Acrylic Sticky Header */
    .mica-nav {
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: saturate(180%) blur(20px);
      border-bottom: 1px solid rgba(0, 0, 0, 0.07);
    }

    /* Universal Icon Hover -> Animate to Microsoft Blue */
    .ms-icon-interactive {
      color: var(--ms-text-muted);
      transition: color 0.4s var(--fluent-silk),
                  transform 0.4s var(--fluent-silk);
    }

    .ms-icon-interactive:hover,
    .group:hover .ms-icon-interactive,
    .fluent-card:hover .ms-icon-interactive,
    .metric-item:hover .ms-icon-interactive,
    .ms-link:hover .ms-icon-interactive {
      color: var(--ms-blue) !important;
    }

    /* Subtle Fluent Card & Image Hover */
    .fluent-card {
      background: var(--ms-surface);
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 6px;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.03);
      transition: transform 0.55s var(--fluent-silk),
                  box-shadow 0.55s var(--fluent-silk),
                  border-color 0.55s var(--fluent-silk);
      overflow: hidden;
    }

    .fluent-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
      border-color: rgba(0, 103, 184, 0.28);
    }

    .fluent-card .card-img {
      transition: transform 0.75s var(--fluent-silk);
      will-change: transform;
    }

    .fluent-card:hover .card-img {
      transform: scale(1.025);
    }

    /* Icon Badge Box — Starts Neutral, Animates to Blue on Hover */
    .fluent-icon-box {
      width: 40px;
      height: 40px;
      border-radius: 6px;
      background: rgba(0, 0, 0, 0.04);
      border: 1px solid rgba(0, 0, 0, 0.08);
      color: var(--ms-text-muted);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background-color 0.45s var(--fluent-silk),
                  border-color 0.45s var(--fluent-silk),
                  transform 0.45s var(--fluent-silk),
                  color 0.45s var(--fluent-silk),
                  box-shadow 0.45s var(--fluent-silk);
    }

    .fluent-icon-box svg {
      transition: transform 0.45s var(--fluent-silk),
                  color 0.45s var(--fluent-silk);
    }

    .fluent-icon-box:hover,
    .metric-item:hover .fluent-icon-box,
    .fluent-card:hover .fluent-icon-box,
    .group:hover .fluent-icon-box {
      background: rgba(0, 103, 184, 0.12);
      border-color: rgba(0, 103, 184, 0.4);
      color: var(--ms-blue) !important;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(0, 103, 184, 0.14);
    }

    .fluent-icon-box:hover svg,
    .metric-item:hover .fluent-icon-box svg,
    .fluent-card:hover .fluent-icon-box svg,
    .group:hover .fluent-icon-box svg {
      color: var(--ms-blue) !important;
      transform: scale(1.08);
    }

    /* Subtle Chevron Link Micro-Interaction */
    .ms-link {
      color: var(--ms-text-dark);
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: color 0.4s var(--fluent-silk);
    }

    .ms-link .icon-chevron {
      color: var(--ms-text-muted);
      transform: translateX(0);
      transition: transform 0.45s var(--fluent-silk),
                  color 0.45s var(--fluent-silk);
    }

    .ms-link:hover,
    .fluent-card:hover .ms-link {
      color: var(--ms-blue);
    }

    .ms-link:hover .icon-chevron,
    .fluent-card:hover .ms-link .icon-chevron {
      color: var(--ms-blue);
      transform: translateX(3.5px);
    }

    /* Primary Button */
    .ms-btn-primary {
      background: var(--ms-blue);
      color: #FFFFFF;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: background-color 0.45s var(--fluent-silk),
                  box-shadow 0.45s var(--fluent-silk);
    }

    .ms-btn-primary svg {
      transition: transform 0.45s var(--fluent-silk);
    }

    .ms-btn-primary:hover {
      background: var(--ms-blue-hover);
      box-shadow: 0 4px 12px rgba(0, 103, 184, 0.22);
    }

    .ms-btn-primary:hover svg {
      transform: translateX(2.5px);
    }

    /* Industry Overlay Corner Icon — Animates to Blue on Hover */
    .industry-badge-icon {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.16);
      backdrop-filter: blur(6px);
      color: #FFFFFF;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background-color 0.45s var(--fluent-silk),
                  color 0.45s var(--fluent-silk),
                  transform 0.45s var(--fluent-silk);
    }

    .fluent-card:hover .industry-badge-icon {
      background: #FFFFFF;
      color: var(--ms-blue);
      transform: translateY(-2px);
    }

    /* ========================================================
       FIXED CSS-GRID STACKED CAROUSEL (NO JUMPING OR OVERLAP)
       ======================================================== */
    .carousel-stack {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;
      align-items: center;
    }

    .carousel-text-slide {
      grid-area: 1 / 1;
      opacity: 0;
      visibility: hidden;
      transform: translateX(28px);
      transition: opacity 0.65s var(--fluent-silk),
                  transform 0.65s var(--fluent-silk),
                  visibility 0.65s;
      pointer-events: none;
    }

    .carousel-text-slide.active {
      opacity: 1;
      visibility: visible;
      transform: translateX(0);
      pointer-events: auto;
      z-index: 2;
    }

    .carousel-img-slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      visibility: hidden;
      transform: scale(1.05) translateX(28px);
      transition: opacity 0.75s var(--fluent-silk),
                  transform 0.75s var(--fluent-silk),
                  visibility 0.75s;
      pointer-events: none;
    }

    .carousel-img-slide.active {
      opacity: 1;
      visibility: visible;
      transform: scale(1) translateX(0);
      pointer-events: auto;
      z-index: 2;
    }

    /* 4-Second Progress Bar Animation */
    @keyframes fillProgress {
      from { width: 0%; }
      to { width: 100%; }
    }

    .carousel-dot-fill {
      width: 0%;
      height: 100%;
      background-color: var(--ms-blue);
    }

    .carousel-dot.active .carousel-dot-fill {
      animation: fillProgress 4000ms linear forwards;
    }

    .carousel-paused .carousel-dot.active .carousel-dot-fill {
      animation-play-state: paused;
    }

    .carousel-dot.completed .carousel-dot-fill {
      width: 100%;
      animation: none;
    }
  </style>
</head>
